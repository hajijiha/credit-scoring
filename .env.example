# 복사해서 사용: cp .env.example .env  (.env 는 커밋 금지)

# --- 서비스 엔드포인트 ---
# 대시보드가 추론을 요청할 FastAPI 주소 (.pkl 직접 로드 금지, 반드시 HTTP 경유)
API_BASE_URL=http://localhost:8000
# MLflow 트래킹 서버 (로컬 파일 백엔드 사용 시: file:./mlruns)
MLFLOW_TRACKING_URI=http://localhost:5000

# --- 실행 환경 ---
# local | docker
APP_ENV=local
LOG_LEVEL=INFO

# --- 경로 오버라이드(선택) ---
# 비워두면 config/config.yaml 의 상대경로를 사용
CONFIG_PATH=config/config.yaml
